417\"},{\"type\":\"string\",\"value\":\"http://identifiers.org/medgen/83266\"},{\"type\":\"string\",\"value\":\"http://identifiers.org/mesh/D057180\"},{\"type\":\"string\",\"value\":\"http://linkedlifedata.com/resource/umls/id/C0338451\"},{\"type\":\"string\",\"value\":\"http://purl.bioontology.org/ontology/ICD10CM/G31.0\"},{\"type\":\"string\",\"value\":\"http://purl.obolibrary.org/obo/DOID_9255\"},{\"type\":\"string\",\"value\":\"http://purl.obolibrary.org/obo/NCIT_C84719\"},{\"type\":\"string\",\"value\":\"http://www.orpha.net/ORDO/Orphanet_282\"}]},\"id\":{\"type\":\"array\",\"value\":[{\"type\":\"string\",\"value\":\"MONDO:0017276\"}]},\"term tracker item\":{\"type\":\"array\",\"value\":[{\"type\":\"string\",\"value\":\"https://github.com/monarch-initiative/mondo/issues/9097\"}]}}}},\"description\":{\"state\":\"present\",\"value\":{\"type\":\"array\",\"value\":[{\"type\":\"string\",\"value\":\"Frontotemporal dementia (FTD) comprises a group of neurodegenerative disorders, characterized by progressive changes in behavior, executive dysfunction and language impairment, as a result of degeneration of the medial prefrontal and frontoinsular cortices. Four clinical subtypes have been identified: semantic dementia, progressive non-fluent aphasia, behavioral variant FTD and right temporal lobar atrophy.\"}]}},\"iri\":{\"state\":\"present\",\"value\":{\"type\":\"string\",\"value\":\"http://purl.obolibrary.org/obo/MONDO_0017276\"}},\"is_obsolete\":{\"state\":\"present\",\"value\":{\"lexeme\":\"false\",\"type\":\"boolean\"}},\"label\":{\"state\":\"present\",\"value\":{\"type\":\"string\",\"value\":\"frontotemporal dementia\"}},\"obo_id\":{\"state\":\"present\",\"value\":{\"type\":\"string\",\"value\":\"MONDO:0017276\"}},\"obo_synonym\":{\"state\":\"present\",\"value\":{\"type\":\"array\",\"value\":[{\"type\":\"object\",\"value\":{\"name\":{\"type\":\"string\",\"value\":\"FTD\"},\"scope\":{\"type\":\"string\",\"value\":\"hasExactSynonym\"},\"type\":{\"type\":\"string\",\"