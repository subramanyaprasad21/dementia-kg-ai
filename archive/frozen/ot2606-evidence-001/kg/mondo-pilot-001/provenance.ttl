familial AD). These cases appear to be inherited in an autosomal dominant manner.\"}]}},\"iri\":{\"state\":\"present\",\"value\":{\"type\":\"string\",\"value\":\"http://purl.obolibrary.org/obo/MONDO_0100087\"}},\"is_obsolete\":{\"state\":\"present\",\"value\":{\"lexeme\":\"false\",\"type\":\"boolean\"}},\"label\":{\"state\":\"present\",\"value\":{\"type\":\"string\",\"value\":\"familial Alzheimer disease\"}},\"obo_id\":{\"state\":\"present\",\"value\":{\"type\":\"string\",\"value\":\"MONDO:0100087\"}},\"obo_synonym\":{\"state\":\"present\",\"value\":{\"type\":\"array\",\"value\":[{\"type\":\"object\",\"value\":{\"name\":{\"type\":\"string\",\"value\":\"Alzheimer disease, familial\"},\"scope\":{\"type\":\"string\",\"value\":\"hasExactSynonym\"},\"type\":{\"type\":\"null\"},\"xrefs\":{\"type\":\"array\",\"value\":[{\"type\":\"object\",\"value\":{\"database\":{\"type\":\"string\",\"value\":\"MESH\"},\"description\":{\"type\":\"null\"},\"id\":{\"type\":\"string\",\"value\":\"C536597\"},\"url\":{\"type\":\"string\",\"value\":\"http://id.nlm.nih.gov/mesh/C536597\"}}}]}}},{\"type\":\"object\",\"value\":{\"name\":{\"type\":\"string\",\"value\":\"FAD\"},\"scope\":{\"type\":\"string\",\"value\":\"hasExactSynonym\"},\"type\":{\"type\":\"string\",\"value\":\"abbreviation\"},\"xrefs\":{\"type\":\"array\",\"value\":[{\"type\":\"object\",\"value\":{\"database\":{\"type\":\"string\",\"value\":\"GARD\"},\"description\":{\"type\":\"null\"},\"id\":{\"type\":\"string\",\"value\":\"0000632\"},\"url\":{\"type\":\"string\",\"value\":\"https://rarediseases.info.nih.gov/?gard_id=0000632\"}}}]}}},{\"type\":\"object\",\"value\":{\"name\":{\"type\":\"string\",\"value\":\"GARD:0000632\"},\"scope\":{\"type\":\"string\",\"value\":\"hasExactSynonym\"},\"type\":{\"type\":\"null\"},\"xrefs\":{\"type\":\"array\",\"value\":[{\"type\":\"object\",\"value\":{\"database\":{\"type\":\"string\",\"value\":\"MONDO\"},\"description\":{\"type\":\"null\"},\"id\":{\"type\":\"string\",\"value\":\"equivalentTo\"},\