    sh:severity sh:Violation ;
    sh:message "V03: Approved owner and participant types for reportedDestination."^^xsd:string ;
    sh:or ( [ sh:class dkg:MappingRecord ] ) ; sh:property [ sh:path dkg:reportedDestination ; sh:nodeKind sh:IRI ; sh:or ( [ sh:class dkg:DiseaseConceptReference ] ) ] .

