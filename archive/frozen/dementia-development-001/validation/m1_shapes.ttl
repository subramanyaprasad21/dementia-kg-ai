    sh:targetSubjectsOf dkg:inSelectionContext ;
    sh:severity sh:Violation ;
    sh:message "V03: Approved owner and participant types for inSelectionContext."^^xsd:string ;
    sh:or ( [ sh:class dkg:SelectionMembership ] [ sh:class dkg:DerivedStatement ] [ sh:class dkg:DiseaseTargetAssociation ] ) ; sh:property [ sh:path dkg:inSelectionContext ; sh:nodeKind sh:IRI ; sh:or ( [ sh:class dkg:SelectionContext ] ) ] .

m1s:Owner_justificationPath a sh:NodeShape ;
    sh:targetSubjectsOf dkg:justificationPath ;
    sh:severity sh:Violation ;
