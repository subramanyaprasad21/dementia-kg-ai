    sh:severity sh:Violation ;
    sh:message "V03: Approved owner and participant types for sharedInput."^^xsd:string ;
    sh:or ( [ sh:class dkg:DerivedStatement ] ) ; sh:property [ sh:path dkg:sharedInput ; sh:nodeKind sh:IRI ; sh:or ( [ sh:class dkg:SourceSnapshot ] [ sh:class dkg:DiseaseConceptReference ] [ sh:class dkg:DiseaseTargetAssociation ] [ sh:class dkg:EvidenceOccurrence ] [ sh:class dkg:MappingRecord ] [ sh:class dkg:SelectionContext ] [ sh:class dkg:SelectionMembership ] [ sh:class dkg:HierarchyStep ] [ sh:class dkg:HierarchyPath ] [ sh:class dkg:StudyRecord ] [ sh:class dkg:MechanismRecord ] [ sh:class dkg:ClinicalIndicationRecord ] [ sh:class dkg:PopulationScope ] [ sh:class dkg:DerivedStatement ] [ sh:class dkg:InspectionRecord ] [ sh:class dkg:MissingnessRecord ] [ sh:class prov:Entity ] [ sh:class dkg:Publication ] [ sh:class dkg:Study ] ) ] .

