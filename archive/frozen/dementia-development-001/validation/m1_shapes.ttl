m1s:IdentifierAuthority a sh:NodeShape ;
    sh:targetSubjectsOf dkg:externalIdentifier ;
    sh:severity sh:Violation ;
    sh:message "V03: An identifier has its authority; label-only references remain allowed."^^xsd:string ;
    sh:property [ sh:path dkg:identifierAuthority ; sh:minCount 1 ; sh:maxCount 1 ] .

m1s:DiseaseIdentity a sh:NodeShape ;
    sh:targetClass dkg:DiseaseConceptReference ;
    sh:severity sh:Violation ;
    sh:message "V03: Observed identifier or label; no fabricated disease reference."^^xsd:string ;
    sh:or ( [ sh:property [ sh:path dkg:externalIdentifier ; sh:minCount 1 ; sh:minLength 1 ] ] [ sh:property [ sh:path dkg:sourceLabel ; sh:minCount 1 ; sh:minLength 1 ] ] ) .

m1s:MappingContent a sh:NodeShape ;
    sh:targetClass dkg:MappingRecord ;
    sh:severity sh:Violation ;
    sh:message "V03: An assignment retains an input or observed/candidate destination."^^xsd:string ;
    sh:or ( [ sh:property [ sh:path dkg:mappingInput ; sh:minCount 1 ] ] [ sh:property [ sh:path dkg:reportedDestination ; sh:minCount 1 ] ] [ sh:property [ sh:path dkg:candidateDestination ; sh:minCount 1 ] ] ) .

m1s:InputOnlyMapping a sh:NodeShape ;
    sh:targetClass dkg:MappingRecord ;
    sh:severity sh:Violation ;
    sh:message "V04: Input-only retains an original input and no reported destination."^^xsd:string ;
    sh:or ( [ sh:not [ sh:property [ sh:path dkg:mappingStatus ; sh:hasValue "input-only"^^xsd:string ] ] ] [ sh:property [ sh:path dkg:mappingInput ; sh:minCount 1 ] ; sh:property [ sh:path dkg:reportedDestination ; sh:maxCount 0 ] ] ) .

m1s:ReviewedMapping a sh:NodeShape ;
    sh:targetClass dkg:MappingRecord ;
    sh:severity sh:Violation ;
    sh:message "V04: Reviewed-with-limits has scoped inspection context; no equivalence inference."^^xsd:string ;
    sh:or ( [ sh:not [ sh:property [ sh:path dkg:mappingStatus ; sh:hasValue "reviewed-with-limits"^^xsd:string ] ] ] [ sh:property [ sh:path [ sh:inversePath dkg:aboutRecord ] ; sh:qualifiedValueShape [ sh:class dkg:InspectionRecord ] ; sh:qualifiedMinCount 1 ] ] ) .

m1s:DirectMembership a sh:NodeShape ;
    sh:targetClass dkg:SelectionMembership ;
    sh:severity sh:Violation ;
    sh:message "V04: Direct-only selection cannot have descendant-selected membership."^^xsd:string ;
    sh:not [ sh:and ( [ sh:property [ sh:path dkg:inclusionKind ; sh:hasValue "descendant-selected"^^xsd:string ] ] [ sh:property [ sh:path dkg:inSelectionContext ; sh:property [ sh:path dkg:selectionMode ; sh:hasValue "direct-only"^^xsd:string ] ] ] ) ] .

m1s:AccessDepth a sh:NodeShape ;
    sh:targetClass dkg:InspectionRecord ;
    sh:severity sh:Violation ;
    sh:message "V04: Inaccessible/not-attempted material has no invented positive inspection depth."^^xsd:string ;
    sh:or ( [ sh:not [ sh:or ( [ sh:property [ sh:path dkg:accessOutcome ; sh:hasValue "inaccessible"^^xsd:string ] ] [ sh:property [ sh:path dkg:accessOutcome ; sh:hasValue "not-attempted"^^xsd:string ] ] ) ] ] [ sh:property [ sh:path dkg:inspectionDepth ; sh:maxCount 0 ] ; sh:property [ sh:path dkg:interpretationOutcome ; sh:in ( "access-limited"^^xsd:string "not-assessed"^^xsd:string ) ] ] ) .

m1s:PartialAccess a sh:NodeShape ;
    sh:targetClass dkg:InspectionRecord ;
    sh:severity sh:Violation ;
    sh:message "V04: Partial access cannot support full-relevant-material depth."^^xsd:string ;
    sh:or ( [ sh:not [ sh:property [ sh:path dkg:accessOutcome ; sh:hasValue "partially-accessible"^^xsd:string ] ] ] [ sh:property [ sh:path dkg:inspectionDepth ; sh:in ( "metadata-only"^^xsd:string "selected-passages"^^xsd:string ) ] ] ) .

m1s:CompletePathSteps a sh:NodeShape ;
    sh:targetClass dkg:HierarchyPath ;
    sh:severity sh:Violation ;
    sh:message "V03: Complete path needs steps; continuity/version compatibility are application checks."^^xsd:string ;
    sh:or ( [ sh:not [ sh:property [ sh:path dkg:completenessStatus ; sh:hasValue "complete-for-declared-scope"^^xsd:string ] ] ] [ sh:property [ sh:path dkg:pathStep ; sh:minCount 1 ] ] ) .

m1s:StepLocator a sh:NodeShape ;
    sh:targetClass dkg:HierarchyStep ;
    sh:severity sh:Violation ;
    sh:message "V08: Step source locator or explicit scoped locator-gap record."^^xsd:string ;
    sh:or ( [ sh:property [ sh:path dkg:sourceLocator ; sh:minCount 1 ; sh:minLength 1 ] ] [ sh:property [ sh:path [ sh:inversePath dkg:aboutRecord ] ; sh:qualifiedValueShape [ sh:class dkg:MissingnessRecord ; sh:property [ sh:path dkg:expectedField ; sh:hasValue "field:sourceLocator"^^xsd:string ] ] ; sh:qualifiedMinCount 1 ] ] ) .

m1s:DependencyParticipants a sh:NodeShape ;
    sh:targetSubjectsOf dkg:dependencyStatus ;
    sh:severity sh:Violation ;
    sh:message "V24: Dependency judgment has participants and stated basis."^^xsd:string ;
    sh:property [ sh:path dkg:subjectRecord ; sh:minCount 1 ; sh:maxCount 1 ] ; sh:property [ sh:path dkg:comparatorRecord ; sh:minCount 1 ; sh:maxCount 1 ] ; sh:property [ sh:path dkg:rationale ; sh:minCount 1 ; sh:minLength 1 ] .

m1s:SharedBasis a sh:NodeShape ;
    sh:targetSubjectsOf dkg:dependencyStatus ;
    sh:severity sh:Violation ;
    sh:message "V24: A declared shared source has an explicit shared input; truth is checked elsewhere."^^xsd:string ;
    sh:or ( [ sh:not [ sh:property [ sh:path dkg:dependencyStatus ; sh:hasValue "shared-source-established"^^xsd:string ] ] ] [ sh:property [ sh:path dkg:sharedInput ; sh:minCount 1 ] ] ) .

m1s:SourceReportedEvidence a sh:NodeShape ;
    sh:targetSubjectsOf dkg:reportedEvidence ;
    sh:severity sh:Violation ;
    sh:message "V03: Source-reported contributions belong to source aggregates."^^xsd:string ;
    sh:property [ sh:path dkg:originRole ; sh:hasValue "source-aggregate"^^xsd:string ] .

m1s:SourceScore_aggregateScore a sh:NodeShape ;
    sh:targetSubjectsOf dkg:aggregateScore ;
    sh:severity sh:Violation ;
    sh:message "V03: Source score context is not a project-grouping score."^^xsd:string ;
    sh:property [ sh:path dkg:originRole ; sh:hasValue "source-aggregate"^^xsd:string ] .

m1s:SourceScore_scoreDefinition a sh:NodeShape ;
    sh:targetSubjectsOf dkg:scoreDefinition ;
    sh:severity sh:Violation ;
    sh:message "V03: Source score context is not a project-grouping score."^^xsd:string ;
    sh:property [ sh:path dkg:originRole ; sh:hasValue "source-aggregate"^^xsd:string ] .

m1s:ScoreContext a sh:NodeShape ;
    sh:targetSubjectsOf dkg:aggregateScore ;
    sh:severity sh:Violation ;
    sh:message "V03: A retained score has a definition or explicit limitation; no causal interpretation."^^xsd:string ;
    sh:or ( [ sh:property [ sh:path dkg:scoreDefinition ; sh:minCount 1 ; sh:minLength 1 ] ] [ sh:property [ sh:path dkg:limitationText ; sh:minCount 1 ; sh:minLength 1 ] ] [ sh:property [ sh:path [ sh:inversePath dkg:aboutRecord ] ; sh:qualifiedValueShape [ sh:class dkg:MissingnessRecord ; sh:property [ sh:path dkg:expectedField ; sh:hasValue "field:scoreDefinition"^^xsd:string ] ] ; sh:qualifiedMinCount 1 ] ] ) .

m1s:PartialSelection a sh:NodeShape ;
    sh:targetClass dkg:SelectionContext ;
    sh:severity sh:Warning ;
    sh:message "V11: Declared completenessStatus limitation requires qualification, not stronger claims."^^xsd:string ;
    sh:not [ sh:property [ sh:path dkg:completenessStatus ; sh:minCount 1 ; sh:in ( "partial"^^xsd:string "unknown"^^xsd:string ) ] ] .

m1s:PartialPath a sh:NodeShape ;
    sh:targetClass dkg:HierarchyPath ;
    sh:severity sh:Warning ;
    sh:message "V09: Declared completenessStatus limitation requires qualification, not stronger claims."^^xsd:string ;
    sh:not [ sh:property [ sh:path dkg:completenessStatus ; sh:minCount 1 ; sh:in ( "partial"^^xsd:string "unknown"^^xsd:string ) ] ] .

m1s:UnresolvedMapping a sh:NodeShape ;
    sh:targetClass dkg:MappingRecord ;
    sh:severity sh:Warning ;
    sh:message "V13: Declared mappingStatus limitation requires qualification, not stronger claims."^^xsd:string ;
    sh:not [ sh:property [ sh:path dkg:mappingStatus ; sh:minCount 1 ; sh:in ( "unresolved"^^xsd:string ) ] ] .

m1s:UnavailableAccess a sh:NodeShape ;
    sh:targetClass dkg:InspectionRecord ;
    sh:severity sh:Warning ;
    sh:message "V14: Declared accessOutcome limitation requires qualification, not stronger claims."^^xsd:string ;
    sh:not [ sh:property [ sh:path dkg:accessOutcome ; sh:minCount 1 ; sh:in ( "inaccessible"^^xsd:string "not-attempted"^^xsd:string ) ] ] .

m1s:RecordedSourceOmission a sh:NodeShape ;
    sh:targetClass dkg:MissingnessRecord ;
    sh:severity sh:Warning ;
    sh:message "V07: Declared missingnessReason limitation requires qualification, not stronger claims."^^xsd:string ;
    sh:not [ sh:property [ sh:path dkg:missingnessReason ; sh:minCount 1 ; sh:in ( "source-omission"^^xsd:string ) ] ] .

m1s:UndatedStatus a sh:NodeShape ;
    sh:targetClass dkg:StudyRecord ;
    sh:severity sh:Warning ;
    sh:message "V22: Reported status lacks a date; do not assert current status."^^xsd:string ;
    sh:or ( [ sh:property [ sh:path dkg:trialStatusText ; sh:maxCount 0 ] ] [ sh:property [ sh:path dkg:statusDate ; sh:minCount 1 ] ] ) .

m1s:UndefinedScore a sh:NodeShape ;
    sh:targetSubjectsOf dkg:aggregateScore ;
    sh:severity sh:Warning ;
    sh:message "V23: Score definition unavailable; retain uninterpreted and qualified."^^xsd:string ;
    sh:property [ sh:path dkg:scoreDefinition ; sh:severity sh:Warning ; sh:minCount 1 ; sh:minLength 1 ] .

m1s:GroupingSelection a sh:NodeShape ;
    sh:targetClass dkg:DiseaseTargetAssociation ;
    sh:severity sh:Violation ;
    sh:message "V03: An association selection context belongs to a project grouping, not a source aggregate."^^xsd:string ;
    sh:or ( [ sh:property [ sh:path dkg:inSelectionContext ; sh:maxCount 0 ] ]
            [ sh:property [ sh:path dkg:originRole ; sh:hasValue "project-grouping"^^xsd:string ] ] ) .

m1s:ClinicalRecordSeparation a sh:NodeShape ;
    sh:targetClass dkg:MechanismRecord ;
    sh:severity sh:Violation ;
    sh:message "V03: Mechanism and indication descriptions remain distinct records."^^xsd:string ;
    sh:not [ sh:class dkg:ClinicalIndicationRecord ] .

m1s:UnresolvedInclusionBasis a sh:NodeShape ;
    sh:targetClass dkg:SelectionMembership ;
    sh:severity sh:Violation ;
    sh:message "V04: Unresolved inclusion retains an explicit limitation; no guessed path."^^xsd:string ;
    sh:or ( [ sh:not [ sh:property [ sh:path dkg:inclusionKind ; sh:hasValue "unresolved"^^xsd:string ] ] ]
            [ sh:property [ sh:path dkg:limitationText ; sh:minCount 1 ; sh:minLength 1 ] ] ) .

m1s:InspectionScope a sh:NodeShape ;
    sh:targetClass dkg:InspectionRecord ;
    sh:severity sh:Violation ;
    sh:message "V04/V24: Selected/full relevant material and full-text-source inspection require explicit scope."^^xsd:string ;
    sh:or ( [ sh:not [ sh:or (
                  [ sh:property [ sh:path dkg:inspectionDepth ; sh:hasValue "selected-passages"^^xsd:string ] ]
                  [ sh:property [ sh:path dkg:inspectionDepth ; sh:hasValue "full-relevant-material"^^xsd:string ] ]
                  [ sh:property [ sh:path dkg:materialKind ; sh:hasValue "full-text-source"^^xsd:string ] ] ) ] ]
            [ sh:property [ sh:path dkg:scopeText ; sh:minCount 1 ; sh:minLength 1 ] ] ) .
