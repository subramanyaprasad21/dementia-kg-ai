@prefix dkg: <https://github.com/subramanyaprasad21/dementia-kg-ai/ontology#> .
@prefix m1s: <https://github.com/subramanyaprasad21/dementia-kg-ai/validation/m1#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Task 008: separate SHACL Core graph; no ontology terms, OWL axioms or inference.
# Constraints are scoped to this M1 record contract, not biomedical completeness.
# Source-shape names and messages map results to V rules without new predicates.

m1s:InformationResource a sh:NodeShape ; sh:or ( [ sh:class dkg:SourceSnapshot ] [ sh:class dkg:DiseaseConceptReference ] [ sh:class dkg:DiseaseTargetAssociation ] [ sh:class dkg:EvidenceOccurrence ] [ sh:class dkg:MappingRecord ] [ sh:class dkg:SelectionContext ] [ sh:class dkg:SelectionMembership ] [ sh:class dkg:HierarchyStep ] [ sh:class dkg:HierarchyPath ] [ sh:class dkg:StudyRecord ] [ sh:class dkg:MechanismRecord ] [ sh:class dkg:ClinicalIndicationRecord ] [ sh:class dkg:PopulationScope ] [ sh:class dkg:DerivedStatement ] [ sh:class dkg:InspectionRecord ] [ sh:class dkg:MissingnessRecord ] [ sh:class prov:Entity ] ) .

m1s:KnownResource a sh:NodeShape ; sh:or ( [ sh:class dkg:SourceSnapshot ] [ sh:class dkg:DiseaseConceptReference ] [ sh:class dkg:Target ] [ sh:class dkg:Drug ] [ sh:class dkg:DiseaseTargetAssociation ] [ sh:class dkg:EvidenceOccurrence ] [ sh:class dkg:MappingRecord ] [ sh:class dkg:SelectionContext ] [ sh:class dkg:SelectionMembership ] [ sh:class dkg:HierarchyStep ] [ sh:class dkg:HierarchyPath ] [ sh:class dkg:Publication ] [ sh:class dkg:Study ] [ sh:class dkg:StudyRecord ] [ sh:class dkg:MechanismRecord ] [ sh:class dkg:ClinicalIndicationRecord ] [ sh:class dkg:PopulationScope ] [ sh:class dkg:DerivedStatement ] [ sh:class dkg:InspectionRecord ] [ sh:class dkg:MissingnessRecord ] [ sh:class prov:Entity ] ) .

m1s:RecordIRI a sh:NodeShape ;
    sh:targetClass dkg:SourceSnapshot, dkg:DiseaseConceptReference, dkg:Target, dkg:Drug, dkg:DiseaseTargetAssociation, dkg:EvidenceOccurrence, dkg:MappingRecord, dkg:SelectionContext, dkg:SelectionMembership, dkg:HierarchyStep, dkg:HierarchyPath, dkg:Publication, dkg:Study, dkg:StudyRecord, dkg:MechanismRecord, dkg:ClinicalIndicationRecord, dkg:PopulationScope, dkg:DerivedStatement, dkg:InspectionRecord, dkg:MissingnessRecord, prov:Entity ;
    sh:severity sh:Violation ;
    sh:message "V03: Identified records use IRIs; no inferred type is supplied."^^xsd:string ;
    sh:nodeKind sh:IRI .

m1s:Owner_inSnapshot a sh:NodeShape ;
    sh:targetSubjectsOf dkg:inSnapshot ;
    sh:severity sh:Violation ;
    sh:message "V03: Approved owner and participant types for inSnapshot."^^xsd:string ;
    sh:node m1s:InformationResource ; sh:property [ sh:path dkg:inSnapshot ; sh:nodeKind sh:IRI ; sh:or ( [ sh:class dkg:SourceSnapshot ] ) ] .

m1s:Owner_contextRecord a sh:NodeShape ;
    sh:targetSubjectsOf dkg:contextRecord ;
    sh:severity sh:Violation ;
    sh:message "V03: Approved owner and participant types for contextRecord."^^xsd:string ;
    sh:node m1s:InformationResource ; sh:property [ sh:path dkg:contextRecord ; sh:nodeKind sh:IRI ; sh:node m1s:InformationResource ] .

m1s:Owner_reportedEvidence a sh:NodeShape ;
    sh:targetSubjectsOf dkg:reportedEvidence ;
    sh:severity sh:Violation ;
    sh:message "V03: Approved owner and participant types for reportedEvidence."^^xsd:string ;
    sh:or ( [ sh:class dkg:DiseaseTargetAssociation ] ) ; sh:property [ sh:path dkg:reportedEvidence ; sh:nodeKind sh:IRI ; sh:or ( [ sh:class dkg:EvidenceOccurrence ] ) ] .

m1s:Owner_mappingContext a sh:NodeShape ;
    sh:targetSubjectsOf dkg:mappingContext ;
    sh:severity sh:Violation ;
    sh:message "V03: Approved owner and participant types for mappingContext."^^xsd:string ;
    sh:or ( [ sh:class dkg:MappingRecord ] ) ; sh:property [ sh:path dkg:mappingContext ; sh:nodeKind sh:IRI ; sh:node m1s:InformationResource ] .

m1s:Owner_mappingInput a sh:NodeShape ;
    sh:targetSubjectsOf dkg:mappingInput ;
    sh:severity sh:Violation ;
    sh:message "V03: Approved owner and participant types for mappingInput."^^xsd:string ;
    sh:or ( [ sh:class dkg:MappingRecord ] ) ; sh:property [ sh:path dkg:mappingInput ; sh:nodeKind sh:IRI ; sh:or ( [ sh:class dkg:DiseaseConceptReference ] ) ] .

m1s:Owner_reportedDestination a sh:NodeShape ;
