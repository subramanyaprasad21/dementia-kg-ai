    sh:or ( [ sh:class dkg:SelectionMembership ] ) ; sh:property [ sh:path dkg:selectedOccurrence ; sh:nodeKind sh:IRI ; sh:or ( [ sh:class dkg:EvidenceOccurrence ] ) ] .

